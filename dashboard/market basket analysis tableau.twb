    <worksheet name='Top 5 Association Rules For Cross Selling/Bundling'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Segoe UI'>Top 5 Association Rules For Cross Selling/Bundling</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (association_rules_apriori)' name='federated.17ggga51g2nfw117l5u2u1fplbiw' />
          </datasources>
          <datasource-dependencies datasource='federated.17ggga51g2nfw117l5u2u1fplbiw'>
            <column caption='Item Combination' datatype='string' name='[Calculation_1440969843740672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[antecedents] + &quot; → &quot; + [consequents]' />
            </column>
            <column caption='Qualified Association Rules' datatype='boolean' name='[Calculation_1544049529249793]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[lift] &gt; 1.5&#13;&#10;AND [support (%)] &gt; 0.1&#13;&#10;AND [confidence (%)] &gt; 10' />
            </column>
            <column caption='Antecedents' datatype='string' name='[antecedents]' role='dimension' type='nominal' />
            <column-instance column='[confidence (%)]' derivation='Avg' name='[avg:confidence (%):qk]' pivot='key' type='quantitative' />
            <column-instance column='[lift]' derivation='Avg' name='[avg:lift:qk]' pivot='key' type='quantitative' />
            <column-instance column='[support (%)]' derivation='Avg' name='[avg:support (%):qk]' pivot='key' type='quantitative' />
            <column caption='Confidence (%)' datatype='real' name='[confidence (%)]' role='measure' type='quantitative' />
            <column caption='Consequents' datatype='string' name='[consequents]' role='dimension' type='nominal' />
            <column caption='Lift' datatype='real' name='[lift]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1440969843740672]' derivation='None' name='[none:Calculation_1440969843740672:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1544049529249793]' derivation='None' name='[none:Calculation_1544049529249793:nk]' pivot='key' type='nominal' />
            <column-instance column='[lift]' derivation='Sum' name='[sum:lift:qk]' pivot='key' type='quantitative' />
            <column caption='Support (%)' datatype='real' name='[support (%)]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.17ggga51g2nfw117l5u2u1fplbiw].[:Measure Names]'>
